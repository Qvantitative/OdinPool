# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# SSL Configuration (REQUIRED for production)
SSL_ENABLED=false
SSL_KEY_PATH=/path/to/your/ssl/privkey.pem
SSL_CERT_PATH=/path/to/your/ssl/fullchain.pem

# CORS Configuration
CORS_ORIGINS=https://odinpool.ai,https://www.odinpool.ai

# Database Configuration (REQUIRED)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=no-verify"

PGUSER=your_db_user
PGPASSWORD=your_db_password
PGHOST=your_db_host
PGPORT=25060
PGDATABASE=your_database_name

# Database Pool Configuration (optional)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Bitcoin RPC Configuration (REQUIRED)
BITCOIN_NETWORK=mainnet
BITCOIN_RPC_USER=your_rpc_user
BITCOIN_RPC_PASSWORD=your_rpc_password
BITCOIN_RPC_HOST=your_bitcoin_node_ip
BITCOIN_RPC_PORT=8332

# Ord Server URL (REQUIRED)
NEXT_PUBLIC_ORD_SERVER_URL=http://your-ord-server:3000
ORD_SERVER_URL=http://your-ord-server:3000

# External Services (REQUIRED for production)
LOCAL_INSTANCE_URL=http://your-local-instance:3001

# API Keys
BESTIN_SLOT_API_KEY=your_bestin_slot_api_key
MAGIC_EDEN_API_KEY=your_magic_eden_api_key

# Logging Configuration (optional)
LOG_LEVEL=info

# Security Configuration (optional)
BODY_LIMIT=5mb
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
